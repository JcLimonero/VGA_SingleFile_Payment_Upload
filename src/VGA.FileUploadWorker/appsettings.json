{
  "ConnectionStrings": {
    "PaymentsDb": "Data/payments.db",
    "DocumentRelationMysql": ""
  },
  "DocumentRelationMysql": {
    "Server": "192.168.190.140",
    "Port": 3306,
    "Database": "single_file",
    "UserId": "vgd_testing",
    "Password": "",
    "ViewName": "view_upload_documents_relation",
    "IdFileColumnName": "IdFile"
  },
  "DocumentByFile": {
    "TableName": "documentbyfile",
    "IdColumnName": "Id",
    "GenerateIdUsingMaxPlusOne": true,
    "NamePrefix": "Liquidacion_",
    "LastUserUpdate": 111,
    "IdLastUserUpdate": 111,
    "IdValidation": "21",
    "IdDocumentType": 1,
    "IdCurrentStatus": 0,
    "IdDocumentError": 0,
    "ServerPath": "",
    "IdDocumentContainer": "path por definir"
  },
  "Upload": {
    "RootPath": "Z:\\",
    "ChannelFolderNames": [ "EFECTIVO", "TPV" ],
    "SuccessSubfolder": "PROCESADOS",
    "FailureSubfolder": "CANCELADOS",
    "ScanIntervalSeconds": 10,
    "FileSearchPattern": "*.*",
    "StoreFileContent": true,
    "DealerFolderTreePath": "Data\\dealer-folder-tree.json",
    "RequireValidPaymentFileName": false,
    "RetryPendingIntervalMinutes": 30
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/import-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
